  <% include /_scripts.ejs %>

  <script>
  /* ── TYPEWRITER ──────────────────────────────────────────── */
  (function () {
    var roles = {
      en: ['Lead Frontend Developer', 'Angular Expert', 'Entrepreneur', 'Teacher'],
      ru: ['Ведущий разработчик', 'Эксперт по Angular', 'Предприниматель', 'Преподаватель']
    };
    var lang = document.documentElement.lang || 'en';
    var titles = roles[lang] || roles.en;
    var el = document.getElementById('typewriter');
    var idx = 0, char = 0, deleting = false;
    function tick() {
      var current = titles[idx];
      if (deleting) {
        el.textContent = current.slice(0, --char);
        if (char <= 0) { deleting = false; idx = (idx + 1) % titles.length; setTimeout(tick, 500); return; }
      } else {
        el.textContent = current.slice(0, ++char);
        if (char >= current.length) { deleting = true; setTimeout(tick, 2200); return; }
      }
      setTimeout(tick, deleting ? 45 : 80);
    }
    setTimeout(tick, 900);
  })();

  /* ── NAV SCROLL + PROGRESS ───────────────────────────────── */
  var nav = document.getElementById('nav');
  var prog = document.getElementById('scroll-progress');
  window.addEventListener('scroll', function () {
    nav.classList.toggle('nav--scrolled', window.scrollY > 50);
    var pct = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
    prog.style.width = Math.min(pct, 100) + '%';
  }, { passive: true });

  /* ── MOBILE BURGER ───────────────────────────────────────── */
  var burger = document.getElementById('nav-burger');
  var navLinks = document.getElementById('nav-links');
  burger.addEventListener('click', function () {
    navLinks.classList.toggle('nav__links--open');
    burger.classList.toggle('nav__burger--active');
  });
  navLinks.querySelectorAll('.nav__link').forEach(function (link) {
    link.addEventListener('click', function () {
      navLinks.classList.remove('nav__links--open');
      burger.classList.remove('nav__burger--active');
    });
  });

  /* ── SCROLL-IN ANIMATIONS ────────────────────────────────── */
  var animObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('visible'); animObserver.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.animate-on-scroll').forEach(function (el) { animObserver.observe(el); });

  /* ── COUNT-UP ────────────────────────────────────────────── */
  function runCount(el) {
    var target = parseInt(el.dataset.count, 10);
    var suffix = el.dataset.suffix || '';
    var duration = 1400;
    var start = performance.now();
    function frame(now) {
      var t = Math.min((now - start) / duration, 1);
      var ease = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.round(ease * target) + suffix;
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
  var countObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.querySelectorAll('[data-count]').forEach(runCount);
        countObserver.unobserve(e.target);
      }
    });
  }, { threshold: 0.4 });
  document.querySelectorAll('.about__stats').forEach(function (el) { countObserver.observe(el); });

  /* ── TALKS PLAYER ────────────────────────────────────────── */
  document.getElementById('talks-list').addEventListener('click', function (e) {
    var btn = e.target.closest('.talk-item');
    if (!btn) return;
    document.querySelectorAll('.talk-item').forEach(function (el) { el.classList.remove('talk-item--active'); });
    btn.classList.add('talk-item--active');
    document.getElementById('talks-iframe').src = 'https://www.youtube.com/embed/' + btn.dataset.id;
  });

  /* ── ACTIVE NAV LINK ON SCROLL ───────────────────────────── */
  var sections = document.querySelectorAll('section[id]');
  var navLinkEls = document.querySelectorAll('.nav__link');
  var sectionObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        navLinkEls.forEach(function (l) { l.classList.remove('nav__link--active'); });
        var active = document.querySelector('.nav__link[href="#' + e.target.id + '"]');
        if (active) active.classList.add('nav__link--active');
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });
  sections.forEach(function (s) { sectionObserver.observe(s); });
  </script>

